# Base de trabajo: se reconstruye con «python -m escrutinio unir» desde data/bd/
data/escrutinio.sqlite
data/escrutinio.sqlite-*
# Intermedios y cachés que se regeneran solos
data/raw/*
# …salvo el texto de los programas electorales, que se versiona por si el partido retira el PDF
!data/raw/programas/
data/raw/programas/*
!data/raw/programas/*.txt
data/logs/
data/llm/pendientes/
*.tmp
__pycache__/
*.pyc

# Diarios y actas pendientes de extraer con IA (se regeneran) y respuestas ya importadas
data/llm/actas/pendientes/
data/llm/actas/respuestas/

# Clave de DeepSeek y demás variables de quien actualiza desde su equipo (copiar de .env.ejemplo)
.env
