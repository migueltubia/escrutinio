{"compromiso": "generales-2015-erc:652f30b8", "iniciativa": "11:162/000147", "relacion": "ninguna", "justificacion": "No aborda la creación ni el apoderamiento de un consejo de gobiernos locales.", "rango": 1, "bm25": 1.33, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T12:21:03+00:00"}
{"compromiso": "generales-2015-erc:eb06eeff", "iniciativa": "11:162/000031", "relacion": "ninguna", "justificacion": "No trata el reconocimiento de la nacionalidad catalana ni el derecho a añadirla a la española.", "rango": 1, "bm25": 2.29, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T12:21:03+00:00"}
{"compromiso": "generales-2015-erc:b7f43aba", "iniciativa": "11:162/000011", "relacion": "ninguna", "justificacion": "No se refiere a la creación de una instancia de encuentro de cargos electos de los Países Catalanes.", "rango": 1, "bm25": 3.56, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T12:21:03+00:00"}
{"compromiso": "generales-2015-erc:76b99e07", "iniciativa": "11:SIN/54e3bf411c", "relacion": "ninguna", "justificacion": "No contempla el incremento de la inversión en políticas sociales hasta el 30 % del PIB.", "rango": 1, "bm25": 3.79, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T12:21:03+00:00"}
{"compromiso": "generales-2015-erc:76b99e07", "iniciativa": "11:SIN/d744188048", "relacion": "ninguna", "justificacion": "No concreta el incremento de la inversión en políticas sociales hasta el 30 % del PIB.", "rango": 2, "bm25": 3.21, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T12:21:03+00:00"}
{"compromiso": "generales-2015-erc:4b491049", "iniciativa": "11:162/000006", "relacion": "ninguna", "justificacion": "No propone unificar las instituciones de la Seguridad Social en una única Agencia de Protección Social.", "rango": 1, "bm25": 2.27, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T12:21:03+00:00"}
