# Copia este fichero como .env, en esta misma carpeta, y pon tu clave. .env está en .gitignore y no
# se sube al repositorio. Las mismas variables valen como variables de entorno del sistema, que
# tienen prioridad; en GitHub Actions van como secreto y variable del repositorio.
DEEPSEEK_API_KEY=

# Opcionales
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
