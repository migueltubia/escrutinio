{"compromiso": "generales-2019-04-pp:c613020a", "iniciativa": "13:410/000002", "relacion": "ninguna", "justificacion": "La iniciativa regula el control parlamentario de acuerdos sin fuerza de ley, no la Ley de Secretos Oficiales ni la protección de información clasificada.", "rango": 1, "bm25": 0.86, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:51+00:00"}
{"compromiso": "generales-2019-04-pp:8893bf0b", "iniciativa": "13:SIN/3546c86f85", "relacion": "ninguna", "justificacion": "La iniciativa crea una comisión mixta de control parlamentario de RTVE, mientras que el compromiso se refiere al modelo de administrador único y al gobierno corporativo de la corporación.", "rango": 1, "bm25": 7.64, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:51+00:00"}
{"compromiso": "generales-2019-04-pp:34be32f8", "iniciativa": "13:173/000004", "relacion": "ninguna", "justificacion": "La iniciativa trata los indultos a condenados por el procés, no la recuperación de la competencia de prisiones cedida a Cataluña.", "rango": 1, "bm25": 3.55, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:51+00:00"}
{"compromiso": "generales-2019-04-pp:22aac6b9", "iniciativa": "13:173/000004", "relacion": "ninguna", "justificacion": "La iniciativa trata los indultos a condenados por el procés, no la reforma de la Euroorden para reconocer la sedición y la rebelión.", "rango": 1, "bm25": 2.53, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:51+00:00"}
{"compromiso": "generales-2019-04-pp:bed62784", "iniciativa": "13:410/000002", "relacion": "ninguna", "justificacion": "La iniciativa modifica el Reglamento del Congreso para el control de acuerdos sin fuerza de ley, no la LOREG ni la participación electoral de los españoles en el exterior.", "rango": 1, "bm25": 1.73, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:51+00:00"}
