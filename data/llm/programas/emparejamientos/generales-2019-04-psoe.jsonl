{"compromiso": "generales-2019-04-psoe:a5a0c479", "iniciativa": "13:162/000047", "relacion": "ninguna", "justificacion": "La iniciativa se refiere a la gratuidad del primer ciclo de Educación Infantil, no a las primeras matrículas de estudios de grado en universidades públicas.", "rango": 1, "bm25": 7.32, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:25+00:00"}
{"compromiso": "generales-2019-04-psoe:a5a0c479", "iniciativa": "13:162/000003", "relacion": "ninguna", "justificacion": "La iniciativa trata la armonización de contenidos y tasas de la EBAU, no la gratuidad de las primeras matrículas universitarias de grado.", "rango": 2, "bm25": 3.12, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:25+00:00"}
{"compromiso": "generales-2019-04-psoe:77e7311b", "iniciativa": "13:162/000003", "relacion": "ninguna", "justificacion": "La iniciativa se refiere a la armonización de la EBAU, no al Estatuto del Personal Docente e Investigador del Sistema Universitario.", "rango": 1, "bm25": 3.12, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:25+00:00"}
{"compromiso": "generales-2019-04-psoe:4d4527ad", "iniciativa": "13:162/000003", "relacion": "ninguna", "justificacion": "La iniciativa versa sobre la armonización de la EBAU, no sobre la creación de un cuerpo único de PDI ni sobre sus niveles y denominaciones.", "rango": 1, "bm25": 3.12, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:25+00:00"}
{"compromiso": "generales-2019-04-psoe:98564d17", "iniciativa": "13:162/000003", "relacion": "ninguna", "justificacion": "La iniciativa se refiere a la armonización de la EBAU, no al procedimiento de consolidación para el acceso a una plaza de PDI permanente.", "rango": 1, "bm25": 3.12, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:25+00:00"}
{"compromiso": "generales-2019-04-psoe:dda9f633", "iniciativa": "13:162/000003", "relacion": "ninguna", "justificacion": "La iniciativa trata la armonización de la EBAU, no el procedimiento de promoción al nivel máximo del PDI.", "rango": 1, "bm25": 3.12, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:25+00:00"}
{"compromiso": "generales-2019-04-psoe:f0fbf5bb", "iniciativa": "13:162/000003", "relacion": "ninguna", "justificacion": "La iniciativa trata la armonización de la EBAU, no la creación de un registro único de concursos de acceso y consolidación del PDI.", "rango": 1, "bm25": 8.37, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:25+00:00"}
{"compromiso": "generales-2019-04-psoe:a1783502", "iniciativa": "13:162/000003", "relacion": "ninguna", "justificacion": "La iniciativa trata la armonización de la EBAU, no un programa de consolidación del profesorado asociado con perfil académico.", "rango": 1, "bm25": 6.61, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:25+00:00"}
{"compromiso": "generales-2019-04-psoe:397fabdc", "iniciativa": "13:162/000003", "relacion": "ninguna", "justificacion": "La iniciativa trata los contenidos y las tasas de la EBAU, no un nuevo modelo global de financiación de las universidades públicas.", "rango": 1, "bm25": 3.12, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:25+00:00"}
{"compromiso": "generales-2019-04-psoe:11f81142", "iniciativa": "13:162/000003", "relacion": "ninguna", "justificacion": "La iniciativa trata la armonización de la EBAU, no la reforma de los criterios y procedimientos de las agencias de calidad universitaria.", "rango": 1, "bm25": 5.57, "modelo": "deepseek:deepseek-flash", "version_prompt": "emparejar-v2", "creado": "2026-09-29T13:13:25+00:00"}
